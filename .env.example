# satu-satunya tempat konfigurasi. copy jadi .env, isi, jangan di-commit.
ELASTIC_VERSION=8.17.0

ELASTIC_PASSWORD=ganti-password-kuat
KIBANA_PASSWORD=ganti-password-kuat-lain
# openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=ganti-32-byte-hex

# private IP VM-nya (ip -4 addr). 0.0.0.0 = terbuka ke semua interface.
BIND_IP=10.0.0.2
# port host — dibatasi allowlist firewall. container tetap 9200/5601 di dalam.
ES_PORT=8030
KIBANA_PORT=8040
ES_HEAP=2g
